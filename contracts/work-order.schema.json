{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "role",
    "scope",
    "goal",
    "acceptance",
    "next_role"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "assigned",
        "in_progress",
        "review",
        "done",
        "blocked",
        "example_only"
      ]
    },
    "role": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "read_ids"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "read_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "goal": {
      "type": "string",
      "minLength": 12
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "next_role": {
      "type": "string"
    },
    "model_tier": {
      "enum": [
        "small",
        "medium",
        "strong",
        "code",
        "human",
        "mixed"
      ]
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9-]+$"
      }
    }
  }
}
