{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent handoff envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "role", "branch", "changed_paths", "inputs", "outputs",
    "claims_with_evidence", "checks_run", "open_questions", "next_role"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
    "role": {"type": "string", "pattern": "^[a-z][a-z_]+$"},
    "branch": {"type": "string", "minLength": 1},
    "changed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "claims_with_evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim", "source_ids"],
        "properties": {
          "claim": {"type": "string", "minLength": 8},
          "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
        }
      }
    },
    "checks_run": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "next_role": {"type": "string", "minLength": 2}
  }
}
