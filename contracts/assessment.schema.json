{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "items"
  ],
  "properties": {
    "unit_id": {
      "type": "string",
      "minLength": 3
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "outcome_id",
          "type",
          "difficulty",
          "stem",
          "options",
          "correct_option",
          "rationale",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q\\.[A-Z0-9.]+$"
          },
          "outcome_id": {
            "type": "string",
            "pattern": "^LO\\.[A-Z0-9.]+$"
          },
          "type": {
            "const": "single_choice"
          },
          "difficulty": {
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "stem": {
            "type": "string",
            "minLength": 10
          },
          "options": {
            "type": "object",
            "minProperties": 2,
            "maxProperties": 6,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "correct_option": {
            "type": "string"
          },
          "rationale": {
            "type": "string",
            "minLength": 12
          },
          "status": {
            "enum": [
              "draft",
              "machine_reviewed",
              "expert_approved",
              "published",
              "deprecated"
            ]
          }
        }
      }
    }
  }
}
